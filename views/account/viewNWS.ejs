<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } else { res.redirect('/') } %>
        <%- messages() %>
        <% if (errors) { %>
            <ul id="errorList" class="notice error">
                <% errors.array().forEach(error=> { %>
                    <li>
                        <%= error.msg %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

<form id="form">
    <div class="form-grid">
        <fieldset class="full-width">
            <legend>Order Details</legend>
            <div class="grid-row">
                <div class="form-group">
                    <label>Order #</label>
                    <input type="text" value="<%= orderData.customization_id || '' %>" readonly>
                </div>
                <div class="form-group">
                    <label>Quantity</label>
                    <input type="text" value="<%= orderData.order_quantity || '' %>" readonly>
                </div>
            </div>
        </fieldset>

        <!-- Customer Information -->
        <fieldset class="full-width">
            <legend>Customer Information</legend>
            <div class="grid-row">
                <div class="form-group">
                    <label>First Name</label>
                    <input type="text" value="<%= orderData.customer_firstname || '' %>" readonly>
                </div>

                <div class="form-group">
                    <label>Last Name</label>
                    <input type="text" value="<%= orderData.customer_lastname || '' %>" readonly>
                </div>
            </div>

            <div class="grid-row">
                <div class="form-group">
                    <label>Address Line 1</label>
                    <input type="text" value="<%= orderData.address_line1 || '' %>" readonly>
                </div>

                <div class="form-group">
                    <label>Address Line 2</label>
                    <input type="text" value="<%= orderData.address_line2 || '' %>" readonly>
                </div>
            </div>

            <div class="grid-row three-col">
                <div class="form-group">
                    <label>City</label>
                    <input type="text" value="<%= orderData.address_city || '' %>" readonly>
                </div>

                <div class="form-group">
                    <label>State</label>
                    <input type="text" value="<%= orderData.address_state || '' %>" readonly>
                </div>

                <div class="form-group">
                    <label>Zip Code</label>
                    <input type="text" value="<%= orderData.address_zip || '' %>" readonly>
                </div>
            </div>
        </fieldset>

        <!-- Product Specifications -->
        <fieldset class="full-width">
            <legend>Product Specifications</legend>
            <div class="grid-row three-col">
                <div class="form-group">
                    <label>Frame Size</label>
                    <input type="text" value="<%= orderData.nws_frame_size || '' %>" readonly>
                </div>

                <div class="form-group">
                    <label>Color</label>
                    <input type="text" value="<%= orderData.nws_color || '' %>" readonly>
                </div>

                <div class="form-group">
                    <label>Mesh</label>
                    <input type="text" value="<%= orderData.nws_mesh || '' %>" readonly>
                </div>

                <div class="form-group">
                    <label>Fastener</label>
                    <input type="text" value="<%= orderData.nws_fastener || '' %>" readonly>
                </div>

                <div class="form-group">
                    <label>Tabs / Spring</label>
                    <input type="text" value="<%= orderData.nws_tab_spring || '' %>" readonly>
                </div>
            </div>
        </fieldset>

        <!-- Dimensions -->
        <fieldset class="full-width">
            <legend>Dimensions</legend>
            <div class="grid-row three-col">
                <div class="form-group">
                    <label>Width Fraction</label>
                    <input type="text" value="<%= orderData.nws_width_fraction || '' %>" readonly>
                </div>

                <div class="form-group">
                    <label>Width +/-</label>
                    <input type="text" value="<%= orderData.nws_width_plus_minus || '' %>" readonly>
                </div>
            </div>

            <div class="grid-row three-col">
                <div class="form-group">
                    <label>Height Fraction</label>
                    <input type="text" value="<%= orderData.nws_height_fraction || '' %>" readonly>
                </div>

                <div class="form-group">
                    <label>Height +/-</label>
                    <input type="text" value="<%= orderData.nws_height_plus_minus || '' %>" readonly>
                </div>
            </div>
        </fieldset>

        <div class="form-actions">
            <a href="/account" class="btn-secondary">← Back to Account</a>
        </div>
    </div>
</form>

<style>
    select:disabled, input[readonly] {
        background-color: #e9ecef;
        cursor: not-allowed;
    }
</style>
