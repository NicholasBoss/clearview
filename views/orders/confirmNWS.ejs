
<% if (title) { %>
    <h1><%= title %></h1>
<% } else { %>
    <h1>Confirm New Window Screen Order</h1>
<% } %>

<%- messages() %>

<div class="confirmation-notice">
    <h2>Please Review Your Order</h2>
    <p>Check all details below. If everything is correct, click "Confirm Order" to save.</p>
</div>

<form id="form" action="/orders/saveNWS" method="post">
    <div class="form-grid">
        <!-- Customer Information -->
        <fieldset class="full-width">
            <legend>Customer Information</legend>
            <div class="grid-row">
                <div class="form-group">
                    <label>Customer First Name</label>
                    <input type="text" name="customer_firstname" value="<%= formData.customer_firstname || '' %>" readonly>
                </div>
                <div class="form-group">
                    <label>Customer Last Name</label>
                    <input type="text" name="customer_lastname" value="<%= formData.customer_lastname || '' %>" readonly>
                </div>
            </div>
        </fieldset>

        <!-- Product Specifications -->
        <fieldset class="full-width">
            <legend>Product Specifications</legend>
            <div class="grid-row three-col">
                <div class="form-group">
                    <label>Quantity</label>
                    <input type="text" name="quantity" value="<%= formData.quantity || formData.order_quantity || '' %>" readonly>
                </div>
                <div class="form-group">
                    <label>Fab</label>
                    <input type="text" name="fab_width" value="<%= formData.quantity || formData.order_quantity || '' %>" readonly>
                </div>
                <div class="form-group">
                    <label>Frame</label>
                    <input type="text" name="frame_size" value="<%= formData.frame_size || formData.nws_frame_size || '' %>" readonly>
                </div>
                <div class="form-group">
                    <label>Color</label>
                    <input type="text" name="color" value="<%= formData.color || formData.nws_color || formData.color_name || '' %>" readonly>
                </div>
                <div class="form-group">
                    <label>Mesh</label>
                    <input type="text" name="mesh" value="<%= formData.mesh || formData.nws_mesh || formData.mesh_type || '' %>" readonly>
                </div>
                <div class="form-group">
                    <label>Fastener</label>
                    <input type="text" name="fastener" value="<%= formData.fastener || formData.nws_fastener || '' %>" readonly>
                </div>
                <div class="form-group">
                    <label>Spring/Tabs</label>
                    <input type="text" name="spring" value="<%= formData.spring || formData.nws_tab_spring || '' %>" readonly>
                </div>
                <div class="form-group">
                    <label>Fastener Location</label>
                    <input type="text" name="fastener_location" value="<%= formData.fastener_location || '' %>" readonly>
                </div>
                <div class="form-group">
                    <label>Notes</label>
                    <input type="text" name="notes" value="<%= formData.notes || '' %>" readonly>
                </div>
            </div>
        </fieldset>

        <!-- Dimensions -->
        <fieldset class="full-width">
            <legend>Dimensions</legend>
            <div class="grid-row three-col">
                <div class="form-group">
                    <label>Width</label>
                    <div class="measurement-input">
                        <input type="text" name="width_input" value="<%= formData.width_input || formData.nws_width_inch || '' %>" readonly>
                        <input type="text" name="measurement_name" value="<%= formData.measurement_name || formData.nws_width_fraction || '' %>" readonly>
                    </div>
                </div>
                <div class="form-group">
                    <label>Width +/-</label>
                    <input type="text" name="width_plus_minus" value="<%= formData.width_plus_minus || formData.nws_width_plus_minus || '' %>" readonly>
                </div>
                <div class="form-group">
                    <label>Height</label>
                    <div class="measurement-input">
                        <input type="text" name="height_input" value="<%= formData.height_input || formData.nws_height_inch || '' %>" readonly>
                        <input type="text" name="height_fraction" value="<%= formData.height_fraction || formData.nws_height_fraction || '' %>" readonly>
                    </div>
                </div>
                <div class="form-group">
                    <label>Height +/-</label>
                    <input type="text" name="height_plus_minus" value="<%= formData.height_plus_minus || formData.nws_height_plus_minus || '' %>" readonly>
                </div>
            </div>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Confirm Order</button>
            <a href="/orders/createNWS" class="btn-secondary">Back to Edit</a>
        </div>
    </div>
</form>
