
<% if (title) { %>
    <h1><%= title %></h1>
<% } else { %>
    <h1>Create New Window Screen Order</h1>
<% } %>

<%- messages() %>
<% if (errors) { %>
    <div class="error-banner">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="currentColor"/>
        </svg>
        <div>
            <strong>Submission Error</strong>
            <p>There are errors with your submission. Please review the form and correct the highlighted fields.</p>
        </div>
    </div>
<% } %>

<script>
  // Auto-fill customer name from session storage if available
  document.addEventListener('DOMContentLoaded', function() {
    const selectedCustomer = sessionStorage.getItem('selectedCustomerId');
    if (selectedCustomer) {
      const [firstName, lastName] = selectedCustomer.split(' ');
      if (firstName) document.getElementById('customer_firstname').value = firstName;
      if (lastName) document.getElementById('customer_lastname').value = lastName;
    }
  });
</script>

<form id="form" action="/orders/confirmNWS" method="post">
    <div class="form-grid">
        <!-- Customer Information -->
        <fieldset class="full-width">
            <legend>Customer Information</legend>
            <div class="grid-row">
                <div class="form-group">
                    <label class="required-field">Customer First Name</label>
                    <input type="text" name="customer_firstname" id="customer_firstname" value="<%= formData.customer_firstname || '' %>" placeholder="Enter customer first name" required <%= errors && errors.array().find(e => e.path === 'customer_firstname') ? 'class="error-input"' : '' %>>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'customer_firstname') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Customer Last Name</label>
                    <input type="text" name="customer_lastname" id="customer_lastname" value="<%= formData.customer_lastname || '' %>" placeholder="Enter customer last name" required <%= errors && errors.array().find(e => e.path === 'customer_lastname') ? 'class="error-input"' : '' %>>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'customer_lastname') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </fieldset>

        <!-- Product Specifications -->
        <fieldset class="full-width">
            <legend>Product Specifications</legend>
            <div class="grid-row three-col">
                <div class="form-group">
                    <label class="required-field">Quantity</label>
                    <input type="text" name="quantity" id="quantity" value="<%= formData.quantity || '' %>" placeholder="Enter quantity" required <%= errors && errors.array().find(e => e.path === 'quantity') ? 'class="error-input"' : '' %>>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'quantity') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Fab</label>
                    <input type="text" name="fab_width" id="fab_width" value="<%= formData.fab_width || '' %>" placeholder="Enter fab width" required <%= errors && errors.array().find(e => e.path === 'fab_width') ? 'class="error-input"' : '' %>>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'fab_width') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Frame</label>
                    <select name="frame_size" id="frame_size" required <%= errors && errors.array().find(e => e.path === 'frame_size') ? 'class="error-input"' : '' %>>
                        <option value="">Select</option>
                        <% frame_sizes.forEach(frame_size => { %>
                            <option value="<%= frame_size.size_type %>" <%= formData.frame_size === frame_size.size_type ? 'selected' : '' %>><%= frame_size.size_type %></option>
                        <% }) %>
                    </select>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'frame_size') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Color</label>
                    <select name="color" id="color" required <%= errors && errors.array().find(e => e.path === 'color') ? 'class="error-input"' : '' %>>
                        <option value="">Select</option>
                        <% colors.forEach(color => { %>
                            <option value="<%= color.color_name %>" <%= formData.color === color.color_name ? 'selected' : '' %>><%= color.color_name %></option>
                        <% }) %>
                    </select>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'color') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Mesh</label>
                    <select name="mesh" id="mesh" required <%= errors && errors.array().find(e => e.path === 'mesh') ? 'class="error-input"' : '' %>>
                        <option value="">Select</option>
                        <% meshs.forEach(mesh => { %>
                            <option value="<%= mesh.mesh_type %>" <%= formData.mesh === mesh.mesh_type ? 'selected' : '' %>><%= mesh.mesh_type %></option>
                        <% }) %>
                    </select>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'mesh') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Fastener</label>
                    <select name="fastener" id="fastener" required <%= errors && errors.array().find(e => e.path === 'fastener') ? 'class="error-input"' : '' %>>
                        <option value="">Select</option>
                        <% fasteners.forEach(fastener => { %>
                            <option value="<%= fastener.fastener_type %>" <%= formData.fastener === fastener.fastener_type ? 'selected' : '' %>><%= fastener.fastener_type %></option>
                        <% }) %>
                    </select>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'fastener') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Spring</label>
                    <select name="spring" id="spring" required <%= errors && errors.array().find(e => e.path === 'spring') ? 'class="error-input"' : '' %>>
                        <option value="">Select</option>
                        <% springs.forEach(spring => { %>
                            <option value="<%= spring.tab_spring_name %>" <%= formData.spring === spring.tab_spring_name ? 'selected' : '' %>><%= spring.tab_spring_name %></option>
                        <% }) %>
                    </select>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'spring') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Fastener Location</label>
                    <input type="text" name="fastener_location" id="fastener_location" value="<%= formData.fastener_location || '' %>" placeholder="Enter fastener location" required <%= errors && errors.array().find(e => e.path === 'fastener_location') ? 'class="error-input"' : '' %>>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'fastener_location') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Notes</label>
                    <input type="text" name="notes" id="notes" value="<%= formData.notes || '' %>" placeholder="Enter notes" required <%= errors && errors.array().find(e => e.path === 'notes') ? 'class="error-input"' : '' %>>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'notes') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </fieldset>

        <!-- Dimensions -->
        <fieldset class="full-width">
            <legend>Dimensions</legend>
            <div class="grid-row three-col">
                <div class="form-group">
                    <label class="required-field">Width</label>
                    <div class="measurement-input">
                        <input type="text" name="width_input" id="width_input" value="<%= formData.width_input || '' %>" placeholder="Enter width" required <%= errors && errors.array().find(e => e.path === 'width_input') ? 'class="error-input"' : '' %>>
                        <select name="measurement_name" id="measurement_name" required <%= errors && errors.array().find(e => e.path === 'measurement_name') ? 'class="error-input"' : '' %>>
                            <option value="">Fraction</option>
                            <% fractions.forEach(fraction => { %>
                            <option value="<%= fraction.measurement_name %>" <%= formData.measurement_name === fraction.measurement_name ? 'selected' : '' %>><%= fraction.measurement_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'width_input') || errors.array().find(e => e.path === 'measurement_name') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Width +/-</label>
                    <select name="width_plus_minus" id="width_plus_minus" required <%= errors && errors.array().find(e => e.path === 'width_plus_minus') ? 'class="error-input"' : '' %>>
                        <option value="">Select</option>
                        <option value="+" <%= formData.width_plus_minus === '+' ? 'selected' : '' %>>+</option>
                        <option value="-" <%= formData.width_plus_minus === '-' ? 'selected' : '' %>>-</option>
                    </select>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'width_plus_minus') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Height</label>
                    <div class="measurement-input">
                        <input type="text" name="height_input" id="height_input" value="<%= formData.height_input || '' %>" placeholder="Enter height" required <%= errors && errors.array().find(e => e.path === 'height_input') ? 'class="error-input"' : '' %>>
                        <select name="height_fraction" id="height_fraction" required <%= errors && errors.array().find(e => e.path === 'height_fraction') ? 'class="error-input"' : '' %>>
                            <option value="">Fraction</option>
                            <% fractions.forEach(fraction => { %>
                            <option value="<%= fraction.measurement_name %>" <%= formData.height_fraction === fraction.measurement_name ? 'selected' : '' %>><%= fraction.measurement_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'height_input') || errors.array().find(e => e.path === 'height_fraction') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Height +/-</label>
                    <select name="height_plus_minus" id="height_plus_minus" required <%= errors && errors.array().find(e => e.path === 'height_plus_minus') ? 'class="error-input"' : '' %>>
                        <option value="">Select</option>
                        <option value="+" <%= formData.height_plus_minus === '+' ? 'selected' : '' %>>+</option>
                        <option value="-" <%= formData.height_plus_minus === '-' ? 'selected' : '' %>>-</option>
                    </select>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'height_plus_minus') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="required-field">Tabs</label>
                    <select name="tabs" id="tabs" required <%= errors && errors.array().find(e => e.path === 'tabs') ? 'class="error-input"' : '' %>>
                        <option value="">Select</option>
                        <option value="L" <%= formData.tabs === 'L' ? 'selected' : '' %>>L</option>
                        <option value="S" <%= formData.tabs === 'S' ? 'selected' : '' %>>S</option>
                        <option value="None" <%= formData.tabs === 'None' ? 'selected' : '' %>>None</option>
                    </select>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'tabs') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </fieldset>

        <!-- Additional Options -->
        <fieldset class="full-width">
            <legend>Additional Options</legend>
            <div class="grid-row two-col">
                <div class="form-group">
                    <label class="required-field">Order Type</label>
                    <select name="order_type" id="order_type" required <%= errors && errors.array().find(e => e.path === 'order_type') ? 'class="error-input"' : '' %>>
                        <option value="">Select</option>
                        <option value="Phone Order" <%= formData.order_type === 'Phone Order' ? 'selected' : '' %>>Phone Order</option>
                        <option value="On-Site Order" <%= formData.order_type === 'On-Site Order' ? 'selected' : '' %>>On-Site Order</option>
                    </select>
                    <% if (errors) { %>
                        <% const error = errors.array().find(e => e.path === 'order_type') %>
                        <% if (error) { %>
                            <span class="error-message"><%= error.msg %></span>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Create Order</button>
        </div>
    </div>
</form>
